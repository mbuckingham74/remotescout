# Remote Scout configuration — copy to .env and fill in.

# Required: Anthropic API key used for recommendation scoring.
ANTHROPIC_API_KEY=

# Optional. Anthropic model used for scoring.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. SQLite database location (relative paths are resolved from the repo root).
# REMOTESCOUT_DATABASE_PATH=instance/remotescout.db

# Optional. Résumé used for scoring.
# REMOTESCOUT_RESUME_PATH=docs/Michael-Buckingham-Resume-Infrastructure-Delivery-Director.pdf

# Optional. Minimum score for a position to be recommended (0-100).
# REMOTESCOUT_RECOMMENDATION_THRESHOLD=70
